{
  "name": "konstelia",
  "displayName": "Konstelia",
  "description": "Create and explore source-code tours for shared code understanding.",
  "version": "0.1.0",
  "publisher": "kenten10",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/kenten10/konstelia#readme",
  "bugs": {
    "url": "https://github.com/kenten10/konstelia/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kenten10/konstelia.git"
  },
  "bin": {
    "tour": "./dist/cli.js"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Education",
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.konstelia/tours/*.tour.yaml",
    "onWebviewPanel:konstelia.tourEditor"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "konstelia.createTour",
        "title": "Create Tour",
        "category": "Konstelia"
      },
      {
        "command": "konstelia.createAnchor",
        "title": "Create Anchor from Selection",
        "category": "Konstelia"
      },
      {
        "command": "konstelia.repairAnchor",
        "title": "Repair Anchor from Selection",
        "category": "Konstelia"
      },
      {
        "command": "konstelia.discoverAnchorRepairs",
        "title": "Repair Anchor Automatically",
        "category": "Konstelia"
      },
      {
        "command": "konstelia.browseTours",
        "title": "Browse Tours",
        "category": "Konstelia"
      },
      {
        "command": "konstelia.editTour",
        "title": "Edit Tour",
        "category": "Konstelia"
      },
      {
        "command": "konstelia.renameTour",
        "title": "Rename Tour",
        "category": "Konstelia"
      },
      {
        "command": "konstelia.deleteTour",
        "title": "Delete Tour",
        "category": "Konstelia"
      },
      {
        "command": "konstelia.showFlowDiagram",
        "title": "Show Flow Diagram",
        "category": "Konstelia"
      },
      {
        "command": "konstelia.playTour",
        "title": "Play Tour",
        "category": "Konstelia"
      },
      {
        "command": "konstelia.playSampleTour",
        "title": "Play Sample Tour",
        "category": "Konstelia"
      },
      {
        "command": "konstelia.installSampleTours",
        "title": "Install Sample Tours",
        "category": "Konstelia"
      },
      {
        "command": "konstelia.playback.exit",
        "title": "End Tour",
        "category": "Konstelia"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "konstelia.playback.exit",
          "when": "konstelia.tourActive"
        }
      ]
    },
    "configuration": {
      "title": "Konstelia",
      "properties": {
        "konstelia.flowDiagram.columns": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 8,
          "description": "How many hops a flow diagram places side by side before wrapping to the next row."
        },
        "konstelia.flowDiagram.revealOnPlayback": {
          "type": "boolean",
          "default": true,
          "description": "Open the Konstelia panel with the flow diagram when a tour starts."
        }
      }
    },
    "colors": [
      {
        "id": "konstelia.primaryAnchorBackground",
        "description": "Background of the primary anchor highlighted during playback.",
        "defaults": {
          "dark": "editor.findMatchBackground",
          "light": "editor.findMatchBackground",
          "highContrast": "editor.findMatchBackground"
        }
      },
      {
        "id": "konstelia.secondaryAnchorBackground",
        "description": "Background of the secondary anchors shown alongside the primary one.",
        "defaults": {
          "dark": "editor.findMatchHighlightBackground",
          "light": "editor.findMatchHighlightBackground",
          "highContrast": "editor.findMatchHighlightBackground"
        }
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "konstelia",
          "title": "Konstelia",
          "icon": "media/konstelia-flow.svg"
        }
      ]
    },
    "views": {
      "konstelia": [
        {
          "id": "konstelia.flowDiagram",
          "name": "Flow Diagram",
          "type": "webview"
        }
      ]
    },
    "keybindings": [
      {
        "command": "konstelia.playback.next",
        "key": "alt+right",
        "when": "konstelia.tourActive && konstelia.tourCanNext"
      },
      {
        "command": "konstelia.playback.blockedNext",
        "key": "alt+right",
        "when": "konstelia.tourActive && !konstelia.tourCanNext"
      },
      {
        "command": "konstelia.playback.previous",
        "key": "alt+left",
        "when": "konstelia.tourActive && konstelia.tourCanPrevious"
      },
      {
        "command": "konstelia.playback.blockedPrevious",
        "key": "alt+left",
        "when": "konstelia.tourActive && !konstelia.tourCanPrevious"
      }
    ]
  },
  "scripts": {
    "clean": "rimraf dist .test-dist",
    "clean:test": "rimraf .test-dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "rimraf dist && esbuild src/extension.ts src/cli.ts --bundle --platform=node --format=cjs --target=node20 --outdir=dist --external:vscode --sourcemap --minify",
    "bundle:watch": "esbuild src/extension.ts src/cli.ts --bundle --platform=node --format=cjs --target=node20 --outdir=dist --external:vscode --sourcemap --watch",
    "compile": "npm run typecheck && npm run bundle",
    "watch": "npm run typecheck && npm run bundle:watch",
    "lint": "eslint src test scripts eslint.config.mjs",
    "test:compile": "tsc -p tsconfig.test.json",
    "test": "npm run clean:test && npm run test:compile && node --test .test-dist/test/*.test.js",
    "tour": "npm run compile --silent && node dist/cli.js",
    "check:public": "node scripts/check-public-repository.mjs --history",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "prepare": "npm run hooks:install",
    "validate": "npm run compile && npm run lint && npm test && npm run check:public",
    "vscode:prepublish": "npm run compile",
    "extension:package": "vsce package --out konstelia.vsix",
    "extension:checksum": "node scripts/create-vsix-checksum.mjs",
    "extension:release": "npm run extension:package && npm run extension:checksum",
    "extension:install": "npm run extension:package && code --install-extension konstelia.vsix --force"
  },
  "dependencies": {
    "@lezer/common": "^1.5.2",
    "@lezer/cpp": "^1.1.6",
    "@lezer/go": "^1.0.1",
    "@lezer/java": "^1.1.3",
    "@lezer/javascript": "^1.5.4",
    "@lezer/python": "^1.1.19",
    "@lezer/rust": "^1.0.2",
    "typescript": "^5.7.3",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.20.0",
    "rimraf": "^6.0.1",
    "typescript-eslint": "^8.24.0"
  },
  "keywords": [
    "code tour",
    "onboarding",
    "walkthrough",
    "documentation",
    "codetour"
  ],
  "icon": "media/icon.png"
}
